/**
 * Facade over the cabi modules — the stable import surface for consumers:
 *
 *     import { cabiRealloc, lowerStringIndirect } from '<root>/lib/zena/cabi/cabi.zena';
 *
 * - `alloc.zena` — cabiRealloc/cabiFree: canonical allocation (FreeListAllocator)
 * - `string.zena` — string lift/lower, direct and indirect result forms
 *
 * Entry modules still must re-export `cabi_realloc` themselves under that
 * exact core name (zena cannot re-export imported declarations under a
 * different core export name — the pick.zena wrapper pattern).
 */
export * from './alloc.zena';
export * from './string.zena';
