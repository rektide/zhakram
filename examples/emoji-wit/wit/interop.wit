package rektide:interop@0.1.0;

interface rng {
  next: func() -> s32;
}

world rng-source {
  export rng;
}

world rng-reader {
  import rng;
  /// Draws 5 numbers via rng, returns them as a comma-separated string.
  export read: func() -> string;
}

/// Command variant of `rng-reader`: a WASI P2 command (wasi:cli/run) that
/// draws 5 numbers via rng and prints them to stdout.
///
/// Stdout is deliberately not declared as an import: a Rust `wasm32-wasip2`
/// command prints via its libc/std surface, which carries its own embedded
/// WASI imports. Declaring e.g. `wasi:cli/stdout@0.2.6` here would collide at
/// command-link time with the toolchain adapter's own copy of the same
/// package versions; the contract of this world is the rng import and the
/// run export.
world rng-reader-command {
  import rng;
  export wasi:cli/run@0.2.0;
}
