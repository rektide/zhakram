// p2-direct hello, written in zena.
//
// Host target + DCE: avoids the wasi target's unconditional fd_write import
// (a p1 import would poison a p2-direct embedding). Linear memory comes from
// zena:memory intrinsics, which export "memory" on any target.
import { Memory } from 'zena:memory';

@external("wasi:cli/stdout@0.2.12", "get-stdout")
declare function __getStdout(): i32;

@external("wasi:io/streams@0.2.12", "[method]output-stream.blocking-write-and-flush")
declare function __bwaf(stream: i32, ptr: i32, len: i32, retptr: i32): void;

@external("wasi:io/streams@0.2.12", "[resource-drop]output-stream")
declare function __dropOutputStream(stream: i32): void;

let mem = Memory.default;

export let run = (): void => {
  let bytes = [104, 101, 108, 108, 111, 32, 112, 50, 10]; // "hello p2\n"
  var ptr = 16;
  for (let b in bytes) {
    mem.setU8(ptr, b);
    ptr += 1;
  }
  let stream = __getStdout();
  __bwaf(stream, 16, bytes.length, 64);
  // NOTE: no [resource-drop] — the browser preview2-shim's stdout dispose
  // path throws {tag:"closed"} after the write lands; stdout is a
  // long-lived host resource, so skipping the drop is both safe and
  // standard guest practice for wasi:cli stdio handles.

};
